//@version=5
indicator("Weekly Range Box + EMAs", overlay=true)

// --- Inputs: Weekly Box ---
showHigh  = input.bool(true, "Show Weekly High Line", group="Weekly Box Settings")
showLow   = input.bool(true, "Show Weekly Low Line", group="Weekly Box Settings")
highColor = input.color(color.red, "High Line Color", group="Weekly Box Style")
lowColor  = input.color(color.green, "Low Line Color", group="Weekly Box Style")
opacity   = input.int(85, "Box Transparency (0-100)", minval=0, maxval=100, group="Weekly Box Style")

// --- Inputs: EMAs ---
showEMAs = input.bool(true, "Show EMAs", group="EMA Settings")
ema50Len  = input.int(50, "EMA 50 Length", group="EMA Settings")
ema100Len = input.int(100, "EMA 100 Length", group="EMA Settings")
ema200Len = input.int(200, "EMA 200 Length", group="EMA Settings")

ema50Col  = input.color(color.orange, "EMA 50 Color", group="EMA Style")
ema100Col = input.color(color.blue, "EMA 100 Color", group="EMA Style")
ema200Col = input.color(color.black, "EMA 200 Color", group="EMA Style")

// --- Logic: Weekly Box ---
// Changed "D" to "W" to fetch weekly data
[wHigh, wLow, wOpen, wClose] = request.security(syminfo.tickerid, "W", [high, low, open, close], lookahead=barmerge.lookahead_on)

isBullish = wClose >= wOpen
boxColor = isBullish ? color.new(color.green, opacity) : color.new(color.red, opacity)

var box weeklyBox = na
// Changed "D" to "W" to detect the start of a new week
if timeframe.change("W")
    weeklyBox := box.new(left=bar_index, top=wHigh, right=bar_index, bottom=wLow, 
                         bgcolor=boxColor, border_color=color.new(color.white, 100))
else
    box.set_right(weeklyBox, bar_index)
    box.set_top(weeklyBox, wHigh)
    box.set_bottom(weeklyBox, wLow)
    box.set_bgcolor(weeklyBox, boxColor)

// --- Logic: EMAs ---
ema50  = ta.ema(close, ema50Len)
ema100 = ta.ema(close, ema100Len)
ema200 = ta.ema(close, ema200Len)

// --- Plotting ---
// Weekly High/Low Lines
plot(showHigh ? wHigh : na, "Weekly High", color=highColor, linewidth=1, style=plot.style_stepline)
plot(showLow ? wLow : na, "Weekly Low", color=lowColor, linewidth=1, style=plot.style_stepline)

// EMA Lines
plot(showEMAs ? ema50 : na, "EMA 50", color=ema50Col, linewidth=1)
plot(showEMAs ? ema100 : na, "EMA 100", color=ema100Col, linewidth=1)
plot(showEMAs ? ema200 : na, "EMA 200", color=ema200Col, linewidth=2)
